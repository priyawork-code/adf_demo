{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demo-adf-review"
		},
		"LS_sqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_sqlserver'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurestoragetestpri.dfs.core.windows.net/"
		},
		"LS_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "db-server-demo-priya.database.windows.net"
		},
		"LS_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-test-priya"
		},
		"LS_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin-priya-test"
		},
		"TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"TGR_EVENT_SIMPLE_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/038bcd04-a892-46f7-80bb-29015c5632ed/resourceGroups/iz-resource-grp-priya/providers/Microsoft.Storage/storageAccounts/azurestoragetestpri"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_DEMO')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read_customer_table",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "select * from dbo.customers where customerid > 3",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "abc",
									"table_name": "abc"
								}
							},
							"firstRowOnly": false
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-07T05:00:57Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_SQL_SERVER')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_DEMO_INGESTION')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Execute_send_email_pipeline_SUCCESS",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "Check source count",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_EMAIL_DEMO",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								},
								"status": "SUCCESS"
							}
						}
					},
					{
						"name": "Execute_send_email_pipeline_FAIL",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "Check source count",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_EMAIL_DEMO",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								},
								"status": "FAIL"
							}
						}
					},
					{
						"name": "Read watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select watermark_value from metadata.table_watermarks where table_name='@{toLower(pipeline().parameters.table_name)}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customer"
								}
							}
						}
					},
					{
						"name": "Check source count",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Check Count in Source",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('Check Count in Source').output.firstRow.count,0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Ingest_SQL_DB_data",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "Select * from dbo.@{toLower(pipeline().parameters.table_name)} where modifieddate > '@{activity('Read watermark').output.firstRow.watermark_value}'\n\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".csv"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL_SERVER",
											"type": "DatasetReference",
											"parameters": {
												"schema": "dbo",
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "CSV_INGEATION",
											"type": "DatasetReference",
											"parameters": {
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "update watermark",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Ingest_SQL_DB_data",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_sqlserver",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update metadata.table_watermarks \nset watermark_value = SYSUTCDATETIME()\nwhere table_name = '@{toUpper(pipeline().parameters.table_name\n)}'\n\n",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					},
					{
						"name": "Check Count in Source",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "Read watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "Select count(*) as count from dbo.@{pipeline().parameters.table_name} where modifieddate > '@{activity('Read watermark').output.firstRow.watermark_value}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string",
						"defaultValue": "customers"
					}
				},
				"variables": {
					"logic_apps_body": {
						"type": "String"
					},
					"email_subject": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-08T11:10:52Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/PL_EMAIL_DEMO')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_SERVER')]",
				"[concat(variables('factoryId'), '/datasets/CSV_INGEATION')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_sqlserver')]"
			]
		},
