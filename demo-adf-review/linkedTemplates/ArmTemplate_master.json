{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demo-adf-review"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurestoragetestpri.dfs.core.windows.net/"
		},
		"LS_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "db-server-demo-priya.database.windows.net"
		},
		"LS_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-test-priya"
		},
		"LS_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin-priya-test"
		},
		"TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"TGR_EVENT_SIMPLE_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/038bcd04-a892-46f7-80bb-29015c5632ed/resourceGroups/iz-resource-grp-priya/providers/Microsoft.Storage/storageAccounts/azurestoragetestpri"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://demo-priya-adf.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "demo-adf-review_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"LS_sqlserver_properties_typeProperties_server": {
						"value": "[parameters('LS_sqlserver_properties_typeProperties_server')]"
					},
					"LS_sqlserver_properties_typeProperties_database": {
						"value": "[parameters('LS_sqlserver_properties_typeProperties_database')]"
					},
					"LS_sqlserver_properties_typeProperties_userName": {
						"value": "[parameters('LS_sqlserver_properties_typeProperties_userName')]"
					},
					"TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name": {
						"value": "[parameters('TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name')]"
					},
					"TGR_EVENT_SIMPLE_properties_typeProperties_scope": {
						"value": "[parameters('TGR_EVENT_SIMPLE_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}